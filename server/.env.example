# 本地付费墙服务配置。复制为 .env 后填写；不要提交 .env。
PORT=8788
HOST=127.0.0.1
# 站点对外地址（用于支付宝 return / notify 回调）。本地联调用 http://127.0.0.1:8788
BASE_URL=http://127.0.0.1:8788
SESSION_SECRET=请改成随机 64 位字符串
COOKIE_SECURE=0         # 上 HTTPS 后改为 1

# 定价（元）
PRICE_PDF=9.90          # 单次下载报告
PRICE_SUB=8.80          # 每月会员（30 天）

# 支付宝开放平台（真实收款必填）
ALIPAY_APP_ID=
# 应用私钥（PKCS8/PKCS1 均可，带不带 PEM 头都行，支持 \n 换行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（用于验签；控制台「支付宝公钥」不是应用公钥）
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 本地服务无公网地址时，notify 回调收不到；支付返回页会主动查单确认。
# 部署到公网后把下面两项改成公网地址。
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=http://127.0.0.1:8788/pay/return

# 本地联调开关：默认关闭。打开后可通过 /api/dev/grant 直接给当前账号加会员/额度，
# 用于没有支付宝密钥时验证整条链路。公网部署必须保持 0。
DEV_GRANT=0
DEV_GRANT_KEY=